# Dependencies (regenerated with "npm install")
node_modules/

# Build output (regenerated by "npm run build" / "cargo build")
dist/
src-tauri/target/

# Tauri auto-generated permission schemas
src-tauri/gen/schemas/

# Generated script bundles (recreated by the esbuild commands in scripts/)
scripts/*.bundle.mjs

# Logs, OS and editor files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.local